// Shared by every configuration. Values here are the official build's; a fork overrides them in
// Signing.xcconfig (git-ignored), which is included last so it wins.
CENTCOM_BUNDLE_ID = studio.extendedmind.centcom
DEVELOPMENT_TEAM =

// Privacy policy and support pages, shown in Settings → About (and required by App Store
// Connect). Empty hides the links. `$()` keeps the `//` of a URL from starting a comment.
CENTCOM_PRIVACY_URL = https:/$()/centcom.app/privacy/
CENTCOM_SUPPORT_URL = https:/$()/centcom.app/support/

#include? "Signing.xcconfig"
